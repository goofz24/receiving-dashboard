# Copy this file to .env.local and fill it in. Never commit .env.local.

# Connection string for the READ-ONLY user (dashboard_reader), not the owner.
# Supabase: Project > Connect > Session pooler. Replace the user part with
#   dashboard_reader.<your-project-ref>  and use the password you set in 03_security.sql.
# Local Postgres example: postgresql://dashboard_reader:yourpassword@localhost:5432/receiving_dev
DATABASE_URL=

# SSL: off (local), require (encrypted, default for remote hosts), or verify (also checks the certificate)
# DATABASE_SSL=require
# DATABASE_CA_CERT=   (only for verify: paste the certificate text)

# Optional: turns on the AI question box. Leave empty to keep it off.
# Use included or prepaid credit only. Don't add a card or turn on auto-reload,
# so the key can never spend more than the credit you have.
ANTHROPIC_API_KEY=
# Default is claude-opus-5-5 (about 1 to 2 cents a question).
# claude-haiku-5-5 is about 40 times cheaper if you want to stretch credit.
# ANTHROPIC_MODEL=claude-opus-5-5

# Most AI questions allowed per day (protects your API budget). Default 20.
# ASK_DAILY_LIMIT=20
